<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lê Nhật Long - Personal Profile & Agency Services</title>
    
    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            --card-bg: rgba(255, 255, 255, 0.75);
            --card-border: rgba(255, 255, 255, 0.9);
            --text-main: #1e293b;
            --text-sub: #64748b;
            --accent-primary: #3b82f6;
            --accent-gradient: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
            --shadow-soft: 0 20px 40px -15px rgba(0, 0, 0, 0.07);
            --shadow-hover: 0 25px 50px -12px rgba(37, 99, 235, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: var(--bg-gradient);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px 16px;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 32px;
            padding: 36px 24px;
            box-shadow: var(--shadow-soft);
            position: relative;
        }

        .profile-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .avatar-wrapper {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 16px;
            cursor: pointer;
        }

        .avatar-ring {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            padding: 4px;
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            animation: rotate 6s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            background-color: #f1f5f9;
        }

        .badge-verified {
            position: absolute;
            bottom: 4px;
            right: 4px;
            background: #2563eb;
            color: #fff;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            border: 3px solid #fff;
        }

        .profile-name {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 6px;
            color: var(--text-main);
        }

        .profile-tag {
            font-size: 14px;
            font-weight: 600;
            color: #2563eb;
            background: rgba(37, 99, 235, 0.08);
            padding: 6px 14px;
            border-radius: 20px;
            display: inline-block;
        }

        .change-avatar-btn {
            margin-top: 12px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-sub);
            background: rgba(0,0,0,0.04);
            border: none;
            padding: 6px 12px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .change-avatar-btn:hover {
            background: rgba(0,0,0,0.08);
            color: var(--text-main);
        }

        .section-title {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-sub);
            margin: 24px 0 12px;
        }

        .links-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .link-card {
            display: flex;
            align-items: center;
            padding: 14px 18px;
            background: #ffffff;
            border-radius: 18px;
            text-decoration: none;
            color: var(--text-main);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(0, 0, 0, 0.04);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .link-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .link-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-right: 14px;
            flex-shrink: 0;
        }

        .icon-zalo { background: #e6f0ff; color: #0068ff; }
        .icon-fb { background: #e7f3ff; color: #1877f2; }
        .icon-gmail { background: #fef2f2; color: #ea4335; }
        .icon-tele { background: #e8f7fd; color: #24a1de; }
        .icon-service { background: #f0fdf4; color: #16a34a; }

        .link-text {
            flex-grow: 1;
        }

        .link-title {
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 2px;
        }

        .link-sub {
            font-size: 12px;
            color: var(--text-sub);
        }

        .action-icon {
            color: #cbd5e1;
            font-size: 14px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(8px);
            z-index: 100;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-content {
            background: #fff;
            padding: 24px;
            border-radius: 24px;
            width: 100%;
            max-width: 360px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .modal-title {
            font-weight: 700;
            margin-bottom: 16px;
        }

        .modal-input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .modal-btns {
            display: flex;
            gap: 8px;
        }

        .modal-btn {
            flex: 1;
            padding: 10px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-confirm { background: #2563eb; color: #fff; }
        .btn-cancel { background: #f1f5f9; color: #475569; }

        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #1e293b;
            color: #fff;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            z-index: 200;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header Profile -->
        <div class="profile-header">
            <div class="avatar-wrapper" onclick="openAvatarModal()">
                <div class="avatar-ring">
                    <img id="userAvatar" src="https://picsum.photos/200" alt="Lê Nhật Long" class="avatar-img">
                </div>
                <div class="badge-verified"><i class="fa-solid fa-check"></i></div>
            </div>
            <h1 class="profile-name">Lê Nhật Long</h1>
            <span class="profile-tag"><i class="fa-solid fa-bolt"></i> Agency Digital & Media</span>
            <div>
                <button class="change-avatar-btn" onclick="openAvatarModal()"><i class="fa-solid fa-camera"></i> Đổi Avatar</button>
            </div>
        </div>

        <!-- Section Contact -->
        <div class="section-title">Thông Tin Liên Hệ</div>
        <div class="links-list">
            <div class="link-card" onclick="copyText('0862878500', 'Đã sao chép SĐT Zalo!')">
                <div class="link-icon icon-zalo"><i class="fa-solid fa-comment-dots"></i></div>
                <div class="link-text">
                    <div class="link-title">Zalo</div>
                    <div class="link-sub">0862878500 (Nhấn để chép)</div>
                </div>
                <i class="fa-solid fa-copy action-icon"></i>
            </div>

            <a href="https://web.facebook.com/lenhatlong200213" target="_blank" class="link-card">
                <div class="link-icon icon-fb"><i class="fa-brands fa-facebook"></i></div>
                <div class="link-text">
                    <div class="link-title">Facebook</div>
                    <div class="link-sub">Lê Nhật Long</div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square action-icon"></i>
            </a>

            <div class="link-card" onclick="copyText('lenhatlong20.contact@gmail.com', 'Đã sao chép Gmail!')">
                <div class="link-icon icon-gmail"><i class="fa-solid fa-envelope"></i></div>
                <div class="link-text">
                    <div class="link-title">Gmail</div>
                    <div class="link-sub">lenhatlong20.contact@gmail.com</div>
                </div>
                <i class="fa-solid fa-copy action-icon"></i>
            </div>

            <a href="https://t.me/nhatlongagency" target="_blank" class="link-card">
                <div class="link-icon icon-tele"><i class="fa-paper-plane fa-brands"></i></div>
                <div class="link-text">
                    <div class="link-title">Telegram</div>
                    <div class="link-sub">@nhatlongagency</div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square action-icon"></i>
            </a>
        </div>

        <!-- Section Services -->
        <div class="section-title">Dịch Vụ Nổi Bật</div>
        <div class="links-list">
            <div class="link-card">
                <div class="link-icon icon-service"><i class="fa-solid fa-chart-line"></i></div>
                <div class="link-text">
                    <div class="link-title">Kéo Tương Tác All MXH</div>
                    <div class="link-sub">Facebook, TikTok, Instagram, Youtube...</div>
                </div>
            </div>

            <div class="link-card">
                <div class="link-icon icon-service"><i class="fa-solid fa-crown"></i></div>
                <div class="link-text">
                    <div class="link-title">Lên Locket Gold</div>
                    <div class="link-sub">Nâng cấp Locket Gold chính chủ uy tín</div>
                </div>
            </div>

            <div class="link-card">
                <div class="link-icon icon-service"><i class="fa-solid fa-coins"></i></div>
                <div class="link-text">
                    <div class="link-title">Nạp Xu TikTok</div>
                    <div class="link-sub">Giá tốt, bảo hành an toàn tuyệt đối</div>
                </div>
            </div>

            <div class="link-card">
                <div class="link-icon icon-service"><i class="fa-solid fa-newspaper"></i></div>
                <div class="link-text">
                    <div class="link-title">Đăng Báo Lên Google</div>
                    <div class="link-sub">PR thương hiệu, xuất hiện Google News</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Change Avatar -->
    <div class="modal" id="avatarModal">
        <div class="modal-content">
            <h3 class="modal-title">Thay Đổi Avatar</h3>
            <input type="text" id="avatarUrlInput" class="modal-input" placeholder="Dán đường dẫn ảnh URL...">
            <input type="file" id="avatarFileInput" class="modal-input" accept="image/*">
            <div class="modal-btns">
                <button class="modal-btn btn-confirm" onclick="saveAvatar()">Lưu</button>
                <button class="modal-btn btn-cancel" onclick="closeAvatarModal()">Hủy</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast">Đã sao chép!</div>

    <script>
        // Load Avatar saved in localStorage
        window.addEventListener('DOMContentLoaded', () => {
            const savedAvatar = localStorage.getItem('user_avatar');
            if(savedAvatar) {
                document.getElementById('userAvatar').src = savedAvatar;
            }
        });

        function copyText(text, message) {
            navigator.clipboard.writeText(text);
            showToast(message);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }

        function openAvatarModal() {
            document.getElementById('avatarModal').style.display = 'flex';
        }

        function closeAvatarModal() {
            document.getElementById('avatarModal').style.display = 'none';
        }

        function saveAvatar() {
            const urlInput = document.getElementById('avatarUrlInput').value;
            const fileInput = document.getElementById('avatarFileInput').files[0];

            if (fileInput) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const base64Img = e.target.result;
                    document.getElementById('userAvatar').src = base64Img;
                    localStorage.setItem('user_avatar', base64Img);
                    closeAvatarModal();
                };
                reader.readAsDataURL(fileInput);
            } else if (urlInput.trim() !== '') {
                document.getElementById('userAvatar').src = urlInput;
                localStorage.setItem('user_avatar', urlInput);
                closeAvatarModal();
            } else {
                closeAvatarModal();
            }
        }
    </script>
</body>
</html>

